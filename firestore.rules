rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isTeacher(userId) {
      // This function reads a document during rule evaluation, so the read must be allowed.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(userId)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      // Allow user to update their own document, and allow anyone signed-in to update classPoints for transactions.
      allow update: if isOwner(userId) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classPoints']));
      allow delete: if isOwner(userId);
      allow create: if request.auth.uid == userId;
      
      // Allow list for fetching class members on 'my-class' page.
      allow list: if isSignedIn();

      // Allow user to read their own sub-collection data.
      match /incorrect-answers/{docId} {
        allow read, write, delete: if isOwner(userId);
      }
      match /solved-incorrect-answers/{docId} {
        allow read, write, delete: if isOwner(userId);
      }
      match /subjectStats/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /playedGameSets/{docId} {
        allow read, write: if isOwner(userId);
      }
       match /pointLogs/{docId} {
        // Allow user to read their own logs, or a teacher to read them.
        allow read: if isOwner(userId) || isTeacher(request.auth.uid);
        allow write: if isSignedIn();
      }
    }

    match /game-sets/{gameSetId} {
      allow read: if isSignedIn();
      // Allow user to list their own created quiz sets.
      allow list: if isSignedIn() && request.query.where[0][0] == 'creatorId' && request.query.where[0][2] == request.auth.uid;
      allow create: if request.auth.uid == request.resource.data.creatorId;
      allow update, delete: if request.auth.uid == resource.data.creatorId || isTeacher(request.auth.uid);
      
      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false; 
      }
    }
    
    match /game-rooms/{roomId} {
        allow read, create, delete: if isSignedIn();
        allow update: if request.auth.uid == resource.data.hostId 
                    || request.auth.uid in resource.data.players;
        // Allow listing of waiting rooms for the dashboard.
        allow list: if isSignedIn() && request.query.where[0][0] == 'status' && request.query.where[0][2] == 'waiting';
    }

    match /class-store-items/{itemId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == request.query.where[0][2];
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if request.auth.uid == resource.data.sellerId || isTeacher(request.auth.uid);
    }
  }
}
