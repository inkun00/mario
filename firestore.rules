rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // [공통 함수]
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher(userId) {
      // This function reads a document during rule evaluation, so the read must be allowed.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(userId)).data.role == 'teacher';
    }
    
    // collectionGroup 쿼리에서 특정 필드의 값을 찾는 함수
    function getQueryValue(fieldName) {
      // request.query.where는 필터 조건의 리스트입니다. 예: [['relatedItemId', '==', 'some-id'], ['type', '==', 'ITEM_PURCHASE']]
      // 이 리스트를 순회하며 fieldName과 일치하는 첫 번째 조건의 값을 반환합니다.
      // Firestore 규칙에는 for 루프가 없으므로, 잠재적인 필터 위치를 수동으로 확인해야 합니다.
      // 여기서는 쿼리가 일관된 순서를 가질 것으로 예상하고 첫 번째와 두 번째 필터만 확인합니다.
      let queryFilters = request.query.where;
      if (queryFilters.size() > 0 && queryFilters[0][0] == fieldName) {
        return queryFilters[0][2];
      }
      if (queryFilters.size() > 1 && queryFilters[1][0] == fieldName) {
        return queryFilters[1][2];
      }
      return null;
    }


    // [사용자 컬렉션]
    match /users/{userId} {
      // 주의: 현재 모든 로그인 유저가 모든 유저의 정보를 수정할 수 있게 되어 있습니다.
      // 운영 단계에서는 isOwner(userId)를 권장합니다.
      allow read, write, delete: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write, delete: if isSignedIn();
      }
    }

    // [상점 아이템 컬렉션]
    match /class-store-items/{itemId} {
      allow read, list: if isSignedIn();
      allow create: if request.auth.uid == request.resource.data.sellerId;
      
      allow update: if isSignedIn() && (
        // 1. 판매자 본인이나 선생님은 모든 수정 가능
        request.auth.uid == resource.data.sellerId || 
        isTeacher(request.auth.uid) ||
        // 2. 구매자는 'quantity' 필드만 수정 가능 (수량 감소 로직 허용)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
      );
      
      allow delete: if request.auth.uid == resource.data.sellerId || isTeacher(request.auth.uid);
    }
    
    // [pointLogs 컬렉션 그룹 룰 추가]
    match /{path=**}/pointLogs/{logId} {
      // 판매자가 자신이 판매한 상품의 구매 기록을 조회하는 것을 허용합니다.
      allow list: if isSignedIn() &&
                    getQueryValue('relatedItemId') != null &&
                    getQueryValue('type') == 'ITEM_PURCHASE' &&
                    get(/databases/$(database)/documents/class-store-items/$(getQueryValue('relatedItemId'))).data.sellerId == request.auth.uid;
    }

    // [게임 세트 및 기타]
    match /game-sets/{gameSetId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn() && request.query.where[0][0] == 'creatorId' && request.query.where[0][2] == request.auth.uid;
      allow create: if request.auth.uid == request.resource.data.creatorId;
      allow update: if 
        // 퀴즈 제작자 또는 선생님은 수정/삭제 가능
        (request.auth.uid == resource.data.creatorId || isTeacher(request.auth.uid)) ||
        // 또는, 로그인한 사용자는 playCount 필드만 수정 가능
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount']));

      allow delete: if request.auth.uid == resource.data.creatorId || isTeacher(request.auth.uid);
      
      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false; 
      }
    }
    
    match /game-rooms/{roomId} {
        allow read, create, delete: if isSignedIn();
        // Allow any signed-in user to join a waiting room,
        // or allow an existing player/host to update the room state.
        allow update: if (isSignedIn() && resource.data.status == 'waiting') ||
                       (request.auth.uid == resource.data.hostId) ||
                       (request.auth.uid in resource.data.playerUIDs);
        allow list: if isSignedIn() && request.query.where[0][0] == 'status' && request.query.where[0][2] == 'waiting';
    }
  }
}
