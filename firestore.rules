rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // [공통 함수]
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher(uid) {
      // 선생님 여부 확인
      return isSignedIn() && get(/databases/$(database)/documents/users/$(uid)).data.role == 'teacher';
    }

    // [사용자 컬렉션]
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isTeacher(request.auth.uid));

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isTeacher(request.auth.uid));
      }
    }

    // [상점 아이템 컬렉션]
    match /class-store-items/{itemId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.sellerId || 
        isTeacher(request.auth.uid) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
      );
      
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.sellerId || isTeacher(request.auth.uid));
    }
    
    // [pointLogs 컬렉션 그룹 중요 수정]
    match /{path=**}/pointLogs/{logId} {
      // 리스트 조회(Query) 허용 로직
      // Firestore는 쿼리 결과에 포함될 수 있는 모든 문서가 이 규칙을 통과하는지 확인합니다.
      allow list: if isSignedIn() && (
        // 1. 결과 문서가 요청자 자신의 로그이거나
        resource.data.userId == request.auth.uid ||
        // 2. 요청자가 관리자(선생님)이거나
        isTeacher(request.auth.uid) ||
        // 3. 요청자가 결과 문서에 기록된 아이템의 판매자인 경우
        //    (주의: 이 get() 호출은 쿼리 결과 문서 수만큼 실행되어 비용이 증가할 수 있습니다.)
        (resource.data.relatedItemId != null && get(/databases/$(database)/documents/class-store-items/$(resource.data.relatedItemId)).data.sellerId == request.auth.uid)
      );

      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isTeacher(request.auth.uid) ||
        (resource.data.relatedItemId != null && get(/databases/$(database)/documents/class-store-items/$(resource.data.relatedItemId)).data.sellerId == request.auth.uid)
      );
    }

    // [게임 세트]
    match /game-sets/{gameSetId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.creatorId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.creatorId || 
        isTeacher(request.auth.uid) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount'])
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.creatorId || isTeacher(request.auth.uid));
      
      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false; 
      }
    }
    
    // [게임방]
    match /game-rooms/{roomId} {
        allow read, create, delete: if isSignedIn();
        allow update: if isSignedIn() && (
          resource.data.status == 'waiting' ||
          request.auth.uid == resource.data.hostId ||
          request.auth.uid in resource.data.playerUIDs
        );
        allow list: if isSignedIn();
    }
  }
}
